# Caddy — авто-HTTPS (Let's Encrypt) для Gophish.
# Домены и e-mail берутся из переменных окружения (см. .env / docker-compose.yml).

{
	email {$ACME_EMAIL}
	# Для отладки TLS можно временно включить staging-ЦС Let's Encrypt:
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# ── Админка Gophish ──
# Gophish жёстко привязывает Secure-флаг CSRF-cookie к admin_server.use_tls,
# поэтому админка внутри работает по self-signed TLS (use_tls=true), а Caddy
# проксирует к ней по HTTPS с пропуском проверки сертификата и отдаёт браузеру
# валидный сертификат Let's Encrypt.
{$ADMIN_DOMAIN} {
	reverse_proxy https://gophish:3333 {
		transport http {
			tls_insecure_skip_verify
		}
	}
}

# ── Phishing-сервер (лендинги) ──
# Внутри — обычный HTTP на :80, TLS терминирует Caddy.
{$PHISH_DOMAIN} {
	reverse_proxy gophish:80
}
