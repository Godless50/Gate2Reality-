# ── Gophish turnkey — конфигурация окружения ──
# Скопируй в .env (cp .env.example .env) и заполни. Файл .env в git НЕ попадает.

# Домен админ-панели. Нужна DNS A-запись admin.example.com → IP этого сервера.
ADMIN_DOMAIN=admin.example.com

# Домен phishing-сервера (лендинги). DNS A-запись phish.example.com → IP сервера.
# Именно этот хост используется в фишинговых ссылках писем.
PHISH_DOMAIN=phish.example.com

# E-mail для Let's Encrypt (уведомления об истечении сертификатов).
ACME_EMAIL=admin@example.com

# Начальный пароль администратора Gophish (логин: admin).
# Устанавливается ТОЛЬКО при первом создании БД. Оставь пустым, чтобы Gophish
# сгенерировал случайный (тогда возьми его из `docker compose logs gophish`).
GOPHISH_INITIAL_ADMIN_PASSWORD=

# (необязательно) Контактный адрес, показывается на служебных страницах Gophish.
CONTACT_ADDRESS=

# Часовой пояс контейнеров.
TZ=UTC
